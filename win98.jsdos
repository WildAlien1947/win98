[version]
Class=MEDIA
signature="$CHICAGO$"
Provider=%Mfg%

; Disk & Directory sections
;----------------------------------------
[DestinationDirs]
DefaultDestDir       = 11    ; LDID_SYS
Voodoo.Copy          = 11
Voodoo.CopyWin       = 10
Voodoo.DelFiles      = 11
Voodoo.DelWinFiles   = 10
Voodoo.CopyRedist    = 11
VoodooIni.DelFiles   = 10
VoodooInf.Copy       = 17

[SourceDisksNames]
1="Voodoo Graphics Drivers for Windows 9X",,0

[SourceDisksFiles]
FXMEMMAP.VXD=1
MM3DFX.DRV=1
MM3DFX16.DLL=1
MM3DFX32.DLL=1
MSVCRT.DLL=1
